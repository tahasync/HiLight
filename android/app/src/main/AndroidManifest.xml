<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required by the GitHub Releases update check (release builds do not
         inherit the debug manifest's INTERNET permission). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Normal install-time permission (no runtime prompt): keeps the CPU
         alive while a notification-triggered animation plays so the
         cached-app freezer cannot strand the torch lit mid-animation. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Runtime permission for per-contact overrides (prd-v1.2.md §2):
         requested ONLY at the moment the user taps "Add contact", never
         preemptively. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <application
        android:label="hilight"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Quick Settings tile (prd-v1.1.md §4): no new permissions beyond
             what the MVP already requires; the tile drives the same engine. -->
        <service
            android:name=".torch.HilightTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="HiLight"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Notification-listener bridge for trigger effects
             (prd-v1.2.md §2). Access is granted exclusively through the
             system notification-access screen, which the app opens only at
             the moment the user enables a trigger — never preemptively. -->
        <service
            android:name=".torch.HilightNotificationListenerService"
            android:exported="true"
            android:label="HiLight trigger effects"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- Charging triggers (prd-v1.2.md §4): POWER_CONNECTED/DISCONNECTED
             are protected system broadcasts exempt from the implicit-broadcast
             ban; no permission required. All decisions happen in Dart. -->
        <receiver
            android:name=".torch.ChargingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED"/>
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Contacts picker for per-contact overrides (prd-v1.2.md §2):
             required on Android 11+ so the app may resolve the system
             picker activity. -->
        <intent>
            <action android:name="android.intent.action.PICK"/>
            <data android:mimeType="vnd.android.cursor.dir/contact"/>
        </intent>
        <!-- Launchable-app listing for per-app overrides (prd-v1.2.md §3):
             grants visibility of activities other apps expose as launcher
             entry points. No permission involved. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
